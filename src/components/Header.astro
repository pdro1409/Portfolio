---
import { getContent, type Locale } from "../data/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);

const links = [
  { href: "#trabalhos", label: t.nav.work },
  { href: "#trajetoria", label: t.nav.path },
  { href: "#ferramentas", label: t.nav.tools },
  { href: "#contato", label: t.nav.contact },
];

const outraLingua = locale === "pt" ? "/en/" : "/";
---

<header class="sticky top-0 z-50 bg-paper/90 backdrop-blur-sm">
  <div
    class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6 md:px-10"
  >
    <a
      href={locale === "pt" ? "/" : "/en/"}
      class="font-semibold tracking-[-0.02em]"
    >
      Pedro Augusto
    </a>

    <nav class="hidden items-center gap-7 md:flex">
      {
        links.map((link) => (
          <a href={link.href} class="link-tinta text-sm">
            {link.label}
          </a>
        ))
      }
      <a
        href={outraLingua}
        class="text-sm text-ink-faint transition-colors hover:text-signal"
        aria-label={t.nav.otherLangAria}
      >
        {t.nav.otherLang}
      </a>
    </nav>

    <div class="flex items-center gap-4 md:hidden">
      <a
        href={outraLingua}
        class="text-sm text-ink-faint"
        aria-label={t.nav.otherLangAria}
      >
        {t.nav.otherLang}
      </a>
      <button
        id="botao-menu"
        type="button"
        class="text-sm font-medium underline decoration-paper-edge underline-offset-4"
        aria-expanded="false"
        aria-controls="menu-mobile"
      >
        {t.nav.menu}
      </button>
    </div>
  </div>

  <nav
    id="menu-mobile"
    class="hidden border-t border-paper-edge bg-paper px-6 pb-3 md:hidden"
  >
    {
      links.map((link) => (
        <a
          href={link.href}
          class="block border-b border-paper-edge py-3 text-sm last:border-0"
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const botao = document.getElementById("botao-menu");
  const menu = document.getElementById("menu-mobile");

  const fechar = () => {
    menu?.classList.add("hidden");
    botao?.setAttribute("aria-expanded", "false");
  };

  botao?.addEventListener("click", () => {
    const aberto = botao.getAttribute("aria-expanded") === "true";
    menu?.classList.toggle("hidden", aberto);
    botao.setAttribute("aria-expanded", String(!aberto));
  });

  menu?.addEventListener("click", (evento) => {
    if ((evento.target as HTMLElement).closest("a")) fechar();
  });

  document.addEventListener("keydown", (evento) => {
    if (evento.key === "Escape") fechar();
  });
</script>
