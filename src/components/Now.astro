---
import { getContent, PROFILE, type Locale } from "../data/content";
import { buscarCommits, tempoRelativo } from "../lib/github";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const commits = await buscarCommits();
---

{
  commits.length > 0 && (
    <section id="agora" class="px-6 py-16 md:px-10 md:py-24">
      <div class="mx-auto max-w-5xl">
        <h2 class="text-3xl font-semibold tracking-[-0.02em] md:text-4xl">
          {t.now.title}
        </h2>
        <p class="prosa mt-3">{t.now.lead}</p>

        <ul class="mt-10 border-t border-paper-edge">
          {commits.map((commit) => (
            <li class="border-b border-paper-edge">
              <a
                href={commit.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8"
              >
                <span class="text-sm transition-colors group-hover:text-signal sm:text-base">
                  {commit.mensagem}
                </span>
                <span class="shrink-0 text-sm text-ink-faint">
                  {commit.repositorio} · {tempoRelativo(commit.data, locale)}
                </span>
              </a>
            </li>
          ))}
        </ul>

        <p class="mt-5 text-sm text-ink-faint">
          {t.now.note}{" "}
          <a
            href={PROFILE.github}
            target="_blank"
            rel="noopener noreferrer"
            class="link-tinta"
          >
            {t.now.link}
          </a>
        </p>
      </div>
    </section>
  )
}
